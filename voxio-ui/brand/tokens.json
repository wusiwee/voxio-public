{
  "name": "Voxio 设计 token",
  "version": "1.2.0",
  "note": "三端唯一颜色/尺寸来源。改动后必须执行 node voxio-ui/brand/sync-tokens.mjs 重新生成 CSS/SCSS/WPF 资源，验收脚本会校验是否漂移。",
  "color": {
    "primary": "#1B3FA0",
    "primary-hover": "#3D5FB0",
    "primary-active": "#142F7C",
    "primary-bg": "#EDF1FA",
    "primary-border": "#C3D0EA",
    "primary-on-contrast": "#FFFFFF",
    "success": "#22C55E",
    "success-bg": "#EAF7EF",
    "success-border": "#B7E5C8",
    "warning": "#E6A23C",
    "warning-bg": "#FDF3E6",
    "warning-border": "#F2DDB5",
    "danger": "#E5484D",
    "danger-bg": "#FCECEC",
    "danger-border": "#F3C6C8",
    "info": "#7A869A",
    "text": "#1F2733",
    "text-secondary": "#5A6577",
    "text-muted": "#7A869A",
    "text-disabled": "#A8B0BF",
    "border": "#E8ECF4",
    "border-strong": "#D5DBE6",
    "bg-page": "#F5F7FB",
    "bg-card": "#FFFFFF",
    "bg-hover": "#F2F5FA",
    "bg-table-header": "#FAFBFD",
    "bg-mask": "rgba(31, 39, 51, 0.45)",
    "sidebar-bg": "#FFFFFF",
    "sidebar-active-bg": "#EDF1FA",
    "bubble-agent": "#1B3FA0",
    "bubble-visitor": "#FFFFFF",
    "bubble-system": "#F2F5FA"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "pill": "999px",
    "bubble": "12px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(31, 39, 51, 0.06)",
    "md": "0 4px 16px rgba(31, 39, 51, 0.08)",
    "lg": "0 12px 32px rgba(31, 39, 51, 0.12)"
  },
  "space": [
    "4px",
    "8px",
    "12px",
    "16px",
    "20px",
    "24px",
    "32px"
  ],
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "size-xs": "12px",
    "size-sm": "13px",
    "size-md": "14px",
    "size-lg": "16px",
    "size-xl": "18px",
    "size-2xl": "22px",
    "size-stat": "28px",
    "line-height": "1.6"
  },
  "component": {
    "control-height": "40px",
    "navbar-height": "50px",
    "sidebar-width": "200px",
    "chat-panel-width": "380px",
    "chat-panel-height": "560px",
    "bubble-max-width": "78%"
  },
  "brand": {
    "name": "Voxio",
    "title": "Voxio 在线客服系统",
    "slogan": "让每一次咨询都有回应",
    "mark": "#1B3FA0",
    "wordmark": "VOXIO",
    "note": "brand.name 是句中文里的品牌写法（Voxio），wordmark 是标志里的全大写写法（VOXIO）；两者不互换"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-std": "200ms",
    "duration-slow": "250ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0.2, 1)",
    "ease-enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "shift": "6px",
    "scale-enter": "0.98",
    "skeleton-duration": "1.2s",
    "toast-duration": "3200ms",
    "attention-duration": "750ms"
  },
  "status": {
    "session": {
      "0": { "label": "排队中", "color": "warning" },
      "1": { "label": "接待中", "color": "primary" },
      "2": { "label": "已结束", "color": "info" }
    },
    "ticket": {
      "0": { "label": "待处理", "color": "warning" },
      "1": { "label": "处理中", "color": "primary" },
      "2": { "label": "已解决", "color": "success" },
      "3": { "label": "已关闭", "color": "info" }
    },
    "agent": {
      "0": { "label": "离线", "color": "info" },
      "1": { "label": "在线", "color": "success" },
      "2": { "label": "忙碌", "color": "warning" }
    }
  }
}
